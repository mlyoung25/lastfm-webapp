# ── Local development (.env) ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Production (Render) sets its own env vars in the dashboard — do NOT set
# NODE_ENV=production here or secure cookies will break over http://localhost.

# Get your keys at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_32_char_api_key
LASTFM_API_SECRET=your_32_char_api_secret

# Must match the callback URL you registered with Last.fm.
BASE_URL=http://localhost:3000

# Any random string is fine locally; use a long secret in production.
SESSION_SECRET=change_me_to_random_string

# Leave as development locally. Render sets this to production automatically
# via render.yaml — do not change it here.
NODE_ENV=development
